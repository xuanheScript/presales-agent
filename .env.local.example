# Supabase（服务端环境变量，运行时注入客户端）
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI_GATEWAY_API_KEY: Gateway API 密钥 (必需)
AI_GATEWAY_API_KEY=sk-xxxxxxxxx

# AI_GATEWAY_MODEL: 模型名称 (如: anthropic/claude-sonnet-4-20250514)
AI_GATEWAY_MODEL=xxxx
# Trigger.dev 持久后台任务
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxxxxxxxxxxxxxxx
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxxxxxx

# 自托管 FunASR 内部 Job API（仅服务端）
FUNASR_BASE_URL=http://127.0.0.1:8100
FUNASR_SERVICE_TOKEN=replace_with_a_random_service_token
FUNASR_CONFIG_VERSION=funasr-config-v1
# 本地默认使用 CPU；Apple Silicon 可在验证后尝试 mps，生产 GPU 使用 cuda
FUNASR_DEVICE=cpu
# 可选，本地启动脚本默认监听 127.0.0.1:8100
FUNASR_HOST=127.0.0.1
FUNASR_PORT=8100

# DeepSeek AI 配置
# 文档: https://ai-sdk.dev/providers/ai-sdk-providers/deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxx                        # DeepSeek API 密钥 (必需)
# DeepSeek V4 直接模型 ID；旧 deepseek-chat/deepseek-reasoner 已停止服务
DEEPSEEK_MODEL=deepseek-v4-flash                     # 可选，默认: deepseek-v4-flash

# 阿里 DashScope Embedding 配置（用于 RAG 向量检索）
# 文档: https://help.aliyun.com/zh/model-studio/text-embedding-synchronous-api
DASHSCOPE_API_KEY=sk-xxxxxxxxx                            # DashScope API 密钥 (必需)

# Langfuse 观测性配置 (可选)
# 文档: https://langfuse.com/docs/get-started
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxx                    # Langfuse Secret Key
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxx                    # Langfuse Public Key
LANGFUSE_BASE_URL=https://cloud.langfuse.com           # Langfuse API URL (默认: https://cloud.langfuse.com)
